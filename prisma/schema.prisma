// Gestión de Cartera - Prisma schema for Neon PostgreSQL
// Run: npx prisma generate | npx prisma migrate dev
// URLs are in prisma.config.ts (use DIRECT_URL for migrate)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Ciudad {
  id        String   @id @default(cuid())
  userId    String
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientes Cliente[]
  bills    Bill[]

  @@unique([userId, nombre])
  @@index([userId])
}

model Cliente {
  id        String   @id @default(cuid())
  userId    String
  nombre    String
  nit       String
  direccion String?
  ciudadId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciudad Ciudad   @relation(fields: [ciudadId], references: [id], onDelete: Restrict)
  bills  Bill[]

  @@unique([userId, nit])
  @@index([userId, ciudadId])
}

model Vendedor {
  id        String   @id @default(cuid())
  userId    String
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills       Bill[]
  settlements MonthlySettlement[]

  @@unique([userId, nombre])
  @@index([userId])
}

model Bill {
  id                 String    @id @default(cuid())
  userId             String
  fv                 Int       // Número de factura
  fecha              DateTime  @db.Date
  valor              Decimal   @db.Decimal(14, 2)
  abono              Decimal?  @db.Decimal(14, 2) // Abono
  reteFuente         Decimal?  @db.Decimal(14, 2)
  descuentos         BillDescuento[]
  iva                Decimal?  @db.Decimal(14, 2)
  vSinIva            Decimal?  @db.Decimal(14, 2) // Valor sin IVA (calculated, stored for reports)
  porcentajeComision Decimal   @default(0.05) @db.Decimal(5, 4)
  vComi              Decimal?  @db.Decimal(14, 2) // Valor comisión (calculated)
  flete              Decimal?  @db.Decimal(14, 2)
  comentarios        String?
  conditioned        Boolean   @default(false)
  estado             BillEstado @default(PENDIENTE)
  liquidatedAt       DateTime? // When "liquidar" was pressed
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clienteId   String
  ciudadId    String
  vendedorId  String
  settlementId String?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente   Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  ciudad   Ciudad            @relation(fields: [ciudadId], references: [id], onDelete: Restrict)
  vendedor Vendedor          @relation(fields: [vendedorId], references: [id], onDelete: Restrict)
  settlement MonthlySettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  payments  BillPayment[]

  @@unique([clienteId, fv])
  @@index([userId, fecha])
  @@index([vendedorId, estado])
  @@index([clienteId, fecha])
  @@index([settlementId])
}

model BillDescuento {
  id        String   @id @default(cuid())
  userId    String
  billId    String
  amount    Decimal  @db.Decimal(14, 2)
  concepto  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([userId, billId])
  @@index([billId])
}

model BillPayment {
  id        String   @id @default(cuid())
  userId    String
  billId    String
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([userId, billId, paidAt])
  @@index([billId, paidAt])
}

enum BillEstado {
  PENDIENTE
  LIQUIDADA
}

model MonthlySettlement {
  id         String   @id @default(cuid())
  userId     String
  vendedorId String
  month      String   // "YYYY-MM"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  bills    Bill[]

  @@unique([userId, vendedorId, month])
  @@index([userId, vendedorId, month])
  @@index([vendedorId])
}

// Optional: for future Neon Auth or simple app users
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ciudades    Ciudad[]
  clientes    Cliente[]
  vendedores  Vendedor[]
  bills       Bill[]
  billDescuentos BillDescuento[]
  billPayments   BillPayment[]
  settlements MonthlySettlement[]
}
